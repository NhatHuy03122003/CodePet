# Database
DATABASE_URL="postgresql://user:password@localhost:5432/codepet"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# GitHub OAuth
# Get these from: https://github.com/settings/developers
# See docs/github-oauth-setup.md for detailed setup instructions
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ByteFox comment provider (Sprint 8): "rule" (offline, default) or "openai"
COMMENT_PROVIDER="rule"

# OpenAI (required only when COMMENT_PROVIDER="openai")
OPENAI_API_KEY="your-openai-api-key"
# Optional model override; defaults to "gpt-4o-mini"
OPENAI_MODEL="gpt-4o-mini"
